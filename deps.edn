{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.7"}
        com.datomic/local {:mvn/version "1.0.301"}
        com.walmartlabs/lacinia {:mvn/version "1.3.0"}
        http-kit/http-kit {:mvn/version "2.8.1"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        metosin/jsonista {:mvn/version "1.0.2"}
        ring/ring-core {:mvn/version "1.15.6"}
        org.clojure/tools.logging {:mvn/version "1.3.2"}
        ch.qos.logback/logback-classic {:mvn/version "1.6.8"}}
 :aliases
 {:dev {:extra-paths ["dev" "test" "frontend/src"]}
  :test {:extra-paths ["test" "frontend/src"]
         :jvm-opts ["--sun-misc-unsafe-memory-access=allow"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :uberjar {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
            :ns-default build}}}
