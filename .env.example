# Directory dei dati Datomic Local (creata al primo avvio) e nome del database.
DATOMIC_STORAGE_DIR=data
DATOMIC_DB_NAME=gradient

# Indirizzo del backend.
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Origine pubblica unica di frontend e backend. HTTPS obbligatorio fuori da localhost.
AUTH_BASE_URL=http://127.0.0.1:5173
# Generare un segreto casuale di almeno 32 caratteri prima di abilitare un provider.
# AUTH_SECRET=

# Registrare le callback indicate nel README nelle console dei provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WSO2_CLIENT_ID=
WSO2_CLIENT_SECRET=
WSO2_AUTHORIZE_URL=https://iam.unipi.it/oauth2/authorize
WSO2_TOKEN_URL=https://iam.unipi.it/oauth2/token
WSO2_USERINFO_URL=https://iam.unipi.it/oauth2/userinfo
