# Connessione MariaDB del backend locale (variabili d'ambiente o file .env).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gradient
DB_USER=gradient

# Credenziali di esempio esclusivamente per lo sviluppo locale.
DB_PASSWORD=gradient-dev-only

# Serve soltanto per inizializzare il container del Compose di esempio.
DB_ROOT_PASSWORD=gradient-root-dev-only
